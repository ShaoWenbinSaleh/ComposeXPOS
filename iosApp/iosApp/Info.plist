<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>NSLocalNetworkUsageDescription</key>
	<string>ComposeXPOS connects to cash register, ordering, and calling displays on your local network.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>ComposeXPOSCallingHost</key>
	<string>$(COMPOSEXPOS_CALLING_HOST)</string>
	<key>ComposeXPOSCallingPort</key>
	<string>$(COMPOSEXPOS_CALLING_PORT)</string>
</dict>
</plist>
